# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed
.env*
# ...but the documented template does: it is how the next person knows which
# variables the site needs and why.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference site snapshots (HTTrack downloads) — shared via Drive, not git.
# They are large and contain third-party code; keeping them out keeps clones fast.
kristalynmiguel.com/
lillicoart.com/
yuliabas.com/

# scratch space for asset measurement
/.tmp/
