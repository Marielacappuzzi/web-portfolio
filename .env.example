# Absolute origin of the deployed site, no trailing slash.
# Drives canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
#
# Leave unset on Vercel until the real domain exists: the deployment URL is
# picked up automatically from VERCEL_PROJECT_PRODUCTION_URL. Set this once
# the custom domain is pointed at the project — it takes precedence.
NEXT_PUBLIC_SITE_URL=https://marielacrapuzzi.com

# --- Contact form -----------------------------------------------------------
# Without all three the form validates, then says plainly that it is not
# connected. It never reports a false success.

# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender. MUST be an address on a domain verified in Resend — never Mariela's
# Gmail. Forging the visitor's or a Gmail sender fails SPF/DKIM and lands in
# spam. The visitor's address travels in Reply-To, so replying works normally.
CONTACT_FROM="Mariela Crapuzzi <formulario@marielacrapuzzi.com>"

# Where enquiries arrive: Mariela’s Gmail, confirmed 2026-08-22.
CONTACT_TO=marielacrapuzzi9@gmail.com

# --- Anti-spam --------------------------------------------------------------
# reCAPTCHA v3. Optional: without both keys the form still works and relies on
# the honeypot alone. https://www.google.com/recaptcha/admin
#
# The form never blocks on a reCAPTCHA failure — a missing key, a blocked
# script or a slow response all let the enquiry through. Only a confident
# rejection stops it. A lost commission costs more than a filtered spam.

# Site key. Public by design: it identifies the site to Google and is readable
# in the page source either way.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret key. Server-side only, never prefixed NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=
